# 복사해서 .env로 만든 뒤 값을 채운다. .env는 커밋하지 않는다.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# 8080을 다른 서버가 쓰고 있을 때만 주석을 풀고 채운다.
# SERVER_PORT=

# 브라우저에서 API를 호출할 프론트 주소. 비우면 모든 출처를 허용한다. 예: https://app.example.com
# CORS_ORIGINS=

# 운영자 키(팀만 아는 긴 무작위 값). 비우면 운영자 API가 잠긴다. 예: openssl rand -hex 24
ADMIN_KEY=

# 아래는 기본값과 다를 때만 주석을 풀고 채운다.
# STATS_RATE_PER_MIN=30
# MODEL_VERSION=2026.10.02
# MODEL_BASE_URL=
